# Only needed for the live ingestor. Demo requires no secrets.
#
# La base la levanta ../infra-common, compartida con los demas proyectos del
# workspace. Este proyecto ocupa el esquema `rails` y entra con el rol
# rails_app, cuyo search_path apunta ahi, de modo que las consultas no
# cualifican ningun nombre de tabla.
DATABASE_URL=postgresql://rails_app:dev-rails@127.0.0.1:5435/trackers
NETWORK_RAIL_USERNAME=
NETWORK_RAIL_PASSWORD=
